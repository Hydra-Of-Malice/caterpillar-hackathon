# Production build = served by the cloud API itself (sentinel/cloud/api/spa.py), so the app calls
# its own origin with a relative path. That is what lets one tunnel carry the whole demo: no CORS,
# no mixed content, and HTTPS so navigator.geolocation works on the phones.
#
# `npm run dev` ignores this file and keeps the absolute localhost defaults in src/lib/api.ts.
VITE_CLOUD_URL=/api/v1
VITE_EDGE_URL=/edge/api/v1
