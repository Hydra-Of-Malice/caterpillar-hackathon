# Edge API (FastAPI :8000) and Cloud API (FastAPI :8100)
VITE_EDGE_URL=http://127.0.0.1:8000/api/v1
VITE_CLOUD_URL=http://127.0.0.1:8100/api/v1
# Edge live WebSocket (defaults to the edge URL with ws:// and /ws/live)
# VITE_EDGE_WS=ws://127.0.0.1:8000/api/v1/ws/live
# Mosquitto MQTT-over-WebSocket listener
VITE_MQTT_URL=ws://127.0.0.1:9001
# Set to 1 to skip the network and always use fixtures
VITE_FORCE_MOCK=0
